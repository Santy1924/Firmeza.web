@model IEnumerable<Firmeza.web.Data.Entity.DetalleVenta>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/LayoutDashboard.cshtml";
}

<h1>Index</h1>

<div class="mb-4">
    <a asp-action="Create" class="btn-create">
        <i class="fa-solid fa-plus"></i> Create New
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Venta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Venta.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Producto.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cantidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecioUnitario)
            </td>
            <td>
                <div class="d-flex justify-content-start">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-link action-edit" title="Edit">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="action-link action-details" title="Details">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-delete" title="Delete">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
